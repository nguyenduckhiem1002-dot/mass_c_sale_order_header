projection;
strict ( 2 );
use draft;

define behavior for ZC_MCH_SO_FILE alias ManageFile
{
  use create;
  use update;
  use delete;
  use action uploadExcel;
  use action downloadFile;
  use action downloadTemplate;
  use action PostConfirm;
  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;
  use association _DataFile { create; with draft; }
}

define behavior for ZC_MCH_SO_HDR alias DataFile
{
  use update;
  use delete;
  use association _ManageFile { with draft; }
}
