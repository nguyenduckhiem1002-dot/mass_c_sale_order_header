managed implementation in class zbp_i_mch_so_file unique;
strict ( 2 );

define behavior for ZI_MCH_SO_FILE alias File
persistent table ztb_mch_so_file
lock master
etag master LastChangedAt
{
  create;
  update;
  delete;
  association _Rows { create; }
  field ( readonly ) Uuid, CreatedBy, CreatedAt, LastChangedAt;
  action process result [1] $self;
  mapping for ztb_mch_so_file corresponding;
}

define behavior for ZI_MCH_SO_HDR alias Header
persistent table ztb_mch_so_hdr
lock dependent by _File
{
  update;
  delete;
  association _File;
  field ( readonly ) Uuid, UuidFile, MessageType, Message, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;
  field ( mandatory ) SalesOrder;
  validation validateRow on save { create; update; field SalesOrder; }
  action process result [1] $self;
  mapping for ztb_mch_so_hdr corresponding;
}
